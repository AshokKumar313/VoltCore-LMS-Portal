---
import WokwiSimulationController from './WokwiSimulationController.jsx';

/**
 * VoltCore Apex Academia - Zero-Latency Wokwi Hardware Simulation Sandbox
 * Targets: ESP32 DevKit v1, MFRC522 SPI RFID Reader, SSD1306 OLED Display
 * Tabs: Live Wokwi Iframe, Firmware Sketches, diagram.json Topologies, UART Serial Telemetry
 */

interface Props {
  wokwiId?: string;
  initialTab?: 'simulation' | 'sketch' | 'topology' | 'serial';
}

const {
  wokwiId = "382755291244849153", // Standard Wokwi ESP32 Project Template
  initialTab = "simulation"
} = Astro.props;

// Standard Wokwi Topology Schema for the ESP32 Smart Attendance Node
const diagramJsonData = {
  "version": 1,
  "author": "VoltCore Silicon Architecture Team (Autonomous Cluster)",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-rfid-rc522", "id": "rc522", "top": -40, "left": 280, "attrs": {} },
    { "type": "board-ssd1306", "id": "oled", "top": 180, "left": 280, "attrs": { "i2cAddress": "0x3c" } },
    { "type": "wokwi-led", "id": "led_status", "top": -80, "left": 120, "attrs": { "color": "green" } },
    { "type": "wokwi-resistor", "id": "r1", "top": -50, "left": 120, "attrs": { "value": "330" } },
    { "type": "wokwi-pushbutton", "id": "btn_scan", "top": 120, "left": -120, "attrs": { "color": "blue" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:GND.1", "rc522:GND", "black", [ "v0" ] ],
    [ "esp:3V3", "rc522:3V3", "red", [ "v0" ] ],
    [ "esp:5", "rc522:SDA", "orange", [ "v0" ] ],
    [ "esp:18", "rc522:SCK", "yellow", [ "v0" ] ],
    [ "esp:23", "rc522:MOSI", "green", [ "v0" ] ],
    [ "esp:19", "rc522:MISO", "blue", [ "v0" ] ],
    [ "esp:22", "rc522:RST", "purple", [ "v0" ] ],
    [ "esp:GND.2", "oled:GND", "black", [ "v0" ] ],
    [ "esp:3V3", "oled:VCC", "red", [ "v0" ] ],
    [ "esp:21", "oled:SDA", "cyan", [ "v0" ] ],
    [ "esp:22", "oled:SCL", "magenta", [ "v0" ] ],
    [ "esp:2", "r1:1", "green", [ "v0" ] ],
    [ "r1:2", "led_status:A", "green", [ "v0" ] ],
    [ "esp:GND.1", "led_status:C", "black", [ "v0" ] ],
    [ "esp:0", "btn_scan:2.l", "blue", [ "v0" ] ],
    [ "esp:GND.1", "btn_scan:1.l", "black", [ "v0" ] ]
  ]
};

const diagramJsonString = JSON.stringify(diagramJsonData, null, 2);

const firmwareCodeSample = `/**
 * VoltCore Apex Academia - ESP32 Smart Attendance Node
 * Target: ESP32-WROOM-32 | MFRC522 RFID SPI & SSD1306 I2C
 * Core Engineering Series • Autonomous Test Bench Standards
 */
#include <WiFi.h>
#include <HTTPClient.h>

const char* WIFI_SSID     = "Wokwi-GUEST";
const char* WIFI_PASSWORD = "";
const char* SERVER_URL    = "http://10.0.2.2:5000/api/attendance";
const char* NODE_ID       = "ESP32_VOLTCORE_IOT_01";

#define STATUS_LED_PIN 2
#define MANUAL_BTN_PIN 0

struct StudentCard {
    const char* student_id;
    const char* student_name;
    const char* rfid_uid;
};

const StudentCard ROSTER[] = {
    { "VOLT-ENG-042", "Ashok Kumar A", "E2 80 6F 3B" },
    { "VOLT-ENG-015", "Kavitha Raman", "C3 4D 8A 11" },
    { "FAC-ENG-019",  "Dr. K. S. Parthasarathy", "A4 12 99 F0" }
};

int cardIndex = 0;
unsigned long lastScan = 0;

void setup() {
    Serial.begin(115200);
    pinMode(STATUS_LED_PIN, OUTPUT);
    pinMode(MANUAL_BTN_PIN, INPUT_PULLUP);
    
    Serial.println("\\n[SYSTEM] Connecting to Wi-Fi...");
    WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
    while (WiFi.status() != WL_CONNECTED) {
        delay(250);
        Serial.print(".");
    }
    Serial.printf("\\n[SYSTEM] Connected! IP: %s\\n", WiFi.localIP().toString().c_str());
}

void loop() {
    if (millis() - lastScan >= 15000 || digitalRead(MANUAL_BTN_PIN) == LOW) {
        lastScan = millis();
        const auto& card = ROSTER[cardIndex];
        
        Serial.printf("[SCAN] Student: %s (%s) | UID: %s\\n", card.student_name, card.student_id, card.rfid_uid);
        
        HTTPClient http;
        http.begin(SERVER_URL);
        http.addHeader("Content-Type", "application/json");
        
        char payload[256];
        snprintf(payload, sizeof(payload), 
            "{\\"student_id\\":\\"%s\\",\\"node_id\\":\\"%s\\",\\"rfid_uid\\":\\"%s\\",\\"rssi\\":%d}",
            card.student_id, NODE_ID, card.rfid_uid, WiFi.RSSI());
            
        int httpCode = http.POST((uint8_t*)payload, strlen(payload));
        if (httpCode == 200) {
            Serial.printf("[HTTP 200] Verified! Response: %s\\n", http.getString().c_str());
            digitalWrite(STATUS_LED_PIN, HIGH); delay(100); digitalWrite(STATUS_LED_PIN, LOW);
        } else {
            Serial.printf("[HTTP ERR] Code: %d\\n", httpCode);
        }
        http.end();
        cardIndex = (cardIndex + 1) % 3;
    }
    delay(50);
}`;
