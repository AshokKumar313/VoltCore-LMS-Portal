        <div class="text-slate-300">  RSSI Signal  : -58 dBm</div>
        <div class="text-slate-300">  Gateway IP   : 10.0.2.2</div>
        <div class="text-emerald-400 font-bold">[SYSTEM] Initialization complete. Scan simulation loop active.</div>
        <div class="text-amber-400">[SYSTEM] Tip: Press '⚡ Tap RFID Tag' button above for instant tap.</div>
        <div class="text-slate-600">----------------------------------------------------------------------</div>
        
        <!-- Interactive Simulated Scan Event -->
        <div class="text-[#00F0B5] font-bold pt-2">[CARD DETECTED] Simulated RFID Tap: E2 80 6F 3B</div>
        <div class="text-slate-200">  Student Name : Ashok Kumar A</div>
        <div class="text-slate-200">  Roll Number  : VOLT-ENG-042</div>
        <div class="text-slate-200">  Cluster      : Autonomous Engineering Cluster</div>
        <div class="text-cyan-300">[HTTP POST] Target: http://10.0.2.2:5000/api/attendance</div>
        <div class="text-emerald-400 font-bold">[HTTP RES]  Code: 200 OK | Response: &#123;&quot;status&quot;:&quot;success&quot;,&quot;xp_awarded&quot;:50&#125;</div>
        <div class="text-slate-400">[LED] GPIO 2 pulse acknowledged. Attendance recorded.</div>
      </div>

    </div>

    <!-- Tab 5: Interactive Stimulus Controller Deck -->
    <div id="tab-controller" class="tab-pane hidden w-full p-4">
      <WokwiSimulationController client:load />
    </div>

  </div>
</div>

<script>
  // Tab Switching Controller
  const tabButtons = document.querySelectorAll('.sandbox-tab-btn');
  const tabPanes = document.querySelectorAll('.tab-pane');

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target');
      if (!targetId) return;

      tabButtons.forEach((b) => {
        b.classList.remove('active', 'text-[#00F0B5]', 'bg-[#00693E]/40', 'border-[#00F0B5]/30');
        b.classList.add('text-slate-400');
      });

      btn.classList.add('active', 'text-[#00F0B5]', 'bg-[#00693E]/40', 'border-[#00F0B5]/30');
      btn.classList.remove('text-slate-400');

      tabPanes.forEach((pane) => {
        if (pane.id === targetId) {
          pane.classList.remove('hidden');
          pane.classList.add('block');
        } else {
          pane.classList.add('hidden');
          pane.classList.remove('block');
        }
      });
    });
  });

  // Tap RFID Tag Button Simulation in UART Log
  const triggerScanBtn = document.getElementById('trigger-live-scan-btn');
  const terminalLog = document.getElementById('serial-terminal-log');

  triggerScanBtn?.addEventListener('click', () => {
    if (!terminalLog) return;
    const now = new Date().toLocaleTimeString();
    
    // Switch to serial tab automatically so user can watch the scan!
    const serialTabBtn = document.querySelector('[data-target="tab-serial"]') as HTMLButtonElement | null;
    serialTabBtn?.click();

    const scanDiv = document.createElement('div');
    scanDiv.className = 'pt-2 space-y-0.5 border-t border-slate-800';
    scanDiv.innerHTML = `
      <div class="text-amber-400 font-bold">[${now}] [USER TRIGGER] Manual RFID Card Tap Triggered!</div>
      <div class="text-[#00F0B5] font-semibold">  Card UID     : E2 80 6F 3B</div>
      <div class="text-slate-200">  Student      : Ashok Kumar A (VOLT-ENG-042)</div>
      <div class="text-cyan-300">  [HTTP POST]  Dispatching to Flask Server on port 5000...</div>
      <div class="text-emerald-400 font-bold">  [HTTP 200]   Lab Attendance Logged! +50 XP Awarded (Autonomous Gateway)</div>
    `;
    terminalLog.appendChild(scanDiv);
    terminalLog.scrollTop = terminalLog.scrollHeight;
  });

  // Clear Serial Terminal Buffer
  const clearSerialBtn = document.getElementById('clear-serial-btn');
  clearSerialBtn?.addEventListener('click', () => {
    if (terminalLog) {
      terminalLog.innerHTML = '<div class="text-slate-500 font-mono text-xs">[BUFFER CLEARED] Telemetry listener active...</div>';
    }
  });

  // Copy Code Handlers
  const copyFirmwareBtn = document.getElementById('copy-firmware-btn');
  const copyFirmwareText = document.getElementById('copy-firmware-text');
  copyFirmwareBtn?.addEventListener('click', () => {
    const code = document.querySelector('#tab-sketch code')?.textContent || '';
    navigator.clipboard.writeText(code).then(() => {
      if (copyFirmwareText) copyFirmwareText.textContent = 'Copied!';
      setTimeout(() => {
        if (copyFirmwareText) copyFirmwareText.textContent = 'Copy Sketch';
      }, 2000);
    });
  });

  const copyDiagramBtn = document.getElementById('copy-diagram-json-btn');
  copyDiagramBtn?.addEventListener('click', () => {
    const json = document.querySelector('#tab-topology code')?.textContent || '';
    navigator.clipboard.writeText(json).then(() => {
      copyDiagramBtn.textContent = 'Copied!';
      setTimeout(() => {
        copyDiagramBtn.textContent = 'Copy diagram.json';
      }, 2000);
    });
  });
</script>
