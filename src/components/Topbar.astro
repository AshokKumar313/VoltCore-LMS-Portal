          <span class="tracking-tight">14d</span>
          <span class="hidden md:inline text-[10px] text-amber-300/80 uppercase font-normal">Streak</span>
        </div>

        <!-- XP Multiplier HUD -->
        <div class="hidden lg:flex flex-col items-end px-3 py-1 rounded-xl bg-[#041026]/80 border border-[#00F0B5]/25">
          <div class="flex items-center gap-1 text-[11px] font-mono">
            <span class="text-[#00F0B5] font-bold">⚡ 2.5x XP</span>
            <span class="text-slate-400">| Lvl 18</span>
          </div>
          <div class="w-24 h-1.5 bg-slate-800 rounded-full overflow-hidden mt-1">
            <div class="h-full bg-gradient-to-r from-[#00693E] to-[#00F0B5] rounded-full w-[94%]"></div>
          </div>
        </div>

        <!-- Student Profile: Ashok Kumar A -->
        <div class="relative" id="profile-dropdown-container">
          <button
            type="button"
            id="profile-btn"
            class="flex items-center gap-2.5 p-1 sm:px-2.5 sm:py-1.5 rounded-xl bg-[#041026]/90 border border-[#00F0B5]/30 hover:border-[#00F0B5] transition-all text-left"
          >
            <!-- Avatar Initials -->
            <div class="relative w-8 h-8 rounded-lg bg-gradient-to-tr from-[#00693E] to-[#00F0B5] p-[1.5px] shadow-sm flex-shrink-0">
              <div class="w-full h-full bg-[#020813] rounded-[6px] flex items-center justify-center font-mono font-extrabold text-xs text-[#00F0B5]">
                AK
              </div>
              <span class="absolute -bottom-0.5 -right-0.5 h-2.5 w-2.5 rounded-full bg-emerald-400 ring-2 ring-[#020813]"></span>
            </div>

            <!-- Profile Meta (Desktop) -->
            <div class="hidden md:block text-left">
              <div class="text-xs font-bold text-slate-100 flex items-center gap-1.5 leading-tight">
                <span>Ashok Kumar A</span>
                <span class="text-[9px] font-mono px-1 rounded bg-[#00693E]/40 text-[#00F0B5] border border-[#00F0B5]/20">
                  MIT
                </span>
              </div>
              <div class="text-[10px] font-mono text-slate-400 leading-tight">
                2023MITEC042 • ECE
              </div>
            </div>

            <svg class="w-3.5 h-3.5 text-slate-400 hidden sm:block ml-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
