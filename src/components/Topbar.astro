                <span class="text-emerald-400 font-semibold">MIT Campus, Chromepet</span>
              </div>
              <div class="flex justify-between items-center text-slate-300">
                <span class="text-slate-400">Department:</span>
                <span class="text-slate-200">Electronics Engg</span>
              </div>
              <div class="flex justify-between items-center text-slate-300">
                <span class="text-slate-400">RFID Token:</span>
                <span class="text-[#00F0B5] bg-[#020813] px-1.5 py-0.5 rounded border border-[#00F0B5]/30 font-bold">
                  E2 80 6F 3B
