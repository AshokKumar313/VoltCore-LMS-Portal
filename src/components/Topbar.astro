---
/**
 * VoltCore Apex Academia - Topbar Component
 * German Precision Engineering + Italian Glassmorphism
 * Profile: Ashok Kumar A (MIT Campus, Anna University)
 */
---

<header class="sticky top-0 z-40 w-full border-b border-[#00F0B5]/15 bg-[#020813]/80 backdrop-blur-2xl transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 gap-3">
      
      <!-- Brand & Academic Institution Badge -->
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-3 group">
          <!-- Geometric Circuit Icon -->
          <div class="relative w-10 h-10 rounded-xl bg-gradient-to-br from-[#00693E] via-[#041026] to-[#020813] border border-[#00F0B5]/40 flex items-center justify-center p-2 shadow-emerald-glow group-hover:border-[#00F0B5] transition-all">
            <svg class="w-6 h-6 text-[#00F0B5]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
              <circle cx="12" cy="12" r="3" fill="#00F0B5" fill-opacity="0.3"/>
            </svg>
            <span class="absolute -top-1 -right-1 flex h-2.5 w-2.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#00F0B5] opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-[#00F0B5]"></span>
            </span>
          </div>

          <div class="hidden sm:block">
            <div class="flex items-center gap-2">
              <span class="font-extrabold tracking-tight text-lg text-white font-mono">
                VOLT<span class="text-[#00F0B5]">CORE</span>
              </span>
              <span class="text-[10px] tracking-wider uppercase px-1.5 py-0.5 rounded bg-[#00693E]/50 text-[#00F0B5] border border-[#00F0B5]/30 font-mono font-semibold">
                APEX
              </span>
            </div>
            <p class="text-[10px] font-mono text-slate-400 tracking-tight">
              MIT CAMPUS • ANNA UNIVERSITY
            </p>
          </div>
        </a>

        <!-- Lab Telemetry Pill -->
        <div class="hidden xl:flex items-center gap-2 ml-4 px-2.5 py-1 rounded-full bg-[#041026] border border-[#00F0B5]/20 text-[11px] font-mono text-slate-300">
          <span class="h-1.5 w-1.5 rounded-full bg-[#00F0B5] animate-pulse"></span>
          <span>ESP32-NODE-01</span>
          <span class="text-[#00F0B5] font-semibold">-58 dBm</span>
        </div>
      </div>

      <!-- Center: Instant ⌘K Command Search Trigger -->
      <div class="flex-1 max-w-md mx-2 sm:mx-4">
        <button
          type="button"
          id="cmd-k-search-trigger"
          class="w-full flex items-center justify-between px-3.5 py-2 rounded-xl bg-[#041026]/90 border border-[#00F0B5]/20 hover:border-[#00F0B5]/50 text-slate-400 hover:text-slate-200 text-xs font-mono transition-all shadow-inner group"
        >
          <div class="flex items-center gap-2.5">
            <svg class="w-3.5 h-3.5 text-[#00F0B5] group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <span class="truncate">Search modules, registers, topologies...</span>
          </div>
          <div class="flex items-center gap-1">
            <kbd class="px-1.5 py-0.5 rounded bg-[#020813] border border-slate-700 text-[10px] text-[#00F0B5] font-semibold">
              ⌘K
            </kbd>
          </div>
        </button>
      </div>

      <!-- Right HUD: Gamified Streak, XP Multiplier & Ashok Kumar A Profile -->
      <div class="flex items-center gap-2 sm:gap-3">
        
        <!-- Gamified Streak Counter -->
        <div class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl bg-[#041026]/80 border border-amber-500/30 text-amber-400 text-xs font-mono font-bold shadow-sm" title="Active Lab Streak: 14 Consecutive Days">
