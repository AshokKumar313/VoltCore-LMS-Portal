---
import MainLayout from '../layouts/MainLayout.astro';
import WokwiAutoGrader from '../components/WokwiAutoGrader.jsx';
---

<MainLayout
  title="Wokwi Firmware AutoGrader | VoltCore Apex Academia (Core Series)"
  description="Automated hidden test benches executing register audits, timing analysis, and AST validation on student Wokwi firmware submissions."
  activeNav="autograder"
>
  <div class="space-y-6">
    <!-- Breadcrumb & Header -->
    <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-slate-800 text-xs font-mono">
      <div class="flex items-center gap-2 text-slate-400">
        <a href="/" class="hover:text-[#00F0B5] transition-colors">VoltCore</a>
        <span>/</span>
        <span class="text-[#00F0B5]">Firmware AutoGrader</span>
        <span>/</span>
        <span class="text-slate-500">Regulation 2023</span>
      </div>
      <div class="flex items-center gap-3">
        <span class="px-2 py-0.5 rounded bg-[#00693E]/30 text-[#00F0B5] border border-[#00F0B5]/30">
          Hardware In The Loop Simulation
        </span>
      </div>
    </div>

    <!-- Interactive AutoGrader React Component -->
    <WokwiAutoGrader client:load />
  </div>
</MainLayout>

