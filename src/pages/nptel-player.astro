---
import MainLayout from '../layouts/MainLayout.astro';
import SmartNptelPlayer from '../components/SmartNptelPlayer.jsx';
---

<MainLayout
  title="Smart NPTEL Lecture Player & Timed Notes | VoltCore Apex Academia"
  description="Interactive NPTEL MOOC player mapped to Modular Engineering Curriculum units, with chapter markers, speed control, resume tracking, and timestamped note-taking."
  activeNav="nptel"
>
  <div class="space-y-6">
    <!-- Breadcrumb & Header -->
    <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-slate-800 text-xs font-mono">
      <div class="flex items-center gap-2 text-slate-400">
        <a href="/" class="hover:text-[#00F0B5] transition-colors">VoltCore</a>
        <span>/</span>
        <a href="/nptel" class="hover:text-[#00F0B5] transition-colors">NPTEL Hub</a>
        <span>/</span>
        <span class="text-[#00F0B5]">Smart Video Player</span>
      </div>
      <div class="flex items-center gap-3">
        <span class="px-2.5 py-1 rounded bg-[#00693E]/30 text-[#00F0B5] border border-[#00F0B5]/30">
          YouTube IFrame API • LocalStorage Resume
        </span>
      </div>
    </div>

    <!-- Smart NPTEL Player React Component -->
    <SmartNptelPlayer client:load />
  </div>
</MainLayout>

