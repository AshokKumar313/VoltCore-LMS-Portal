---
import MainLayout from '../layouts/MainLayout.astro';
import PlatformHealthHub from '../components/PlatformHealthHub.jsx';

// Platform Intelligence & Reliability Center Metadata
const platformHealthMetadata = {
  institution: "Autonomous Engineering Cluster",
  department: "Electronics & Embedded Systems",
  regulation: "Modular Engineering Series",
  lead: "VoltCore Apex",
  rollNo: "Core Series",
  workspace: "Platform Intelligence & Reliability Center",
  standards: "SRE SLA 99.98% • SQLite WAL Architecture • APM Latency Sub-5ms • OWASP Security Headers",
  mode: "Service Health Cards + APM Breakdown + SQLite WAL Telemetry + 37-Route Integrity Scanner"
};
---

<MainLayout title={`Platform Intelligence & Reliability Center | VoltCore Apex Academia`} activeNav="system-health">
  <div class="space-y-8 font-mono">
    
    <!-- Hero Header -->
    <div class="glass-card-accent rounded-3xl p-6 sm:p-8 border border-[#00F0B5]/30 relative overflow-hidden shadow-2xl">
      <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
        
        <div class="flex items-center gap-5">
          <!-- Glass Cybernetic Avatar -->
          <div class="relative w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-gradient-to-tr from-[#00693E] to-[#00F0B5] p-[2.5px] shadow-emerald-glow flex-shrink-0">
            <div class="w-full h-full bg-[#020813] rounded-[14px] flex items-center justify-center font-bold text-2xl text-[#00F0B5]">
              ⚡
            </div>
            <span class="absolute -bottom-1 -right-1 h-4 w-4 rounded-full bg-emerald-400 ring-4 ring-[#020813] animate-pulse"></span>
          </div>

          <div>
            <div class="flex flex-wrap items-center gap-2">
              <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight font-sans">
                Platform Intelligence &amp; Reliability Center
              </h1>
              <span class="px-2.5 py-0.5 rounded-full bg-[#00693E]/50 text-[#00F0B5] text-xs font-bold border border-[#00F0B5]/40">
                PHASE 28 ENTERPRISE SRE
              </span>
            </div>
            <div class="text-xs sm:text-sm text-slate-300 mt-1">
              {platformHealthMetadata.department} • {platformHealthMetadata.institution}
            </div>
            <div class="text-xs text-slate-400 mt-0.5">
              Platform Architect: <span class="text-white font-bold">{platformHealthMetadata.lead} ({platformHealthMetadata.rollNo})</span> • {platformHealthMetadata.workspace}
            </div>
          </div>
        </div>

        <!-- System Capability Badges -->
        <div class="flex flex-wrap items-center gap-3">
          <div class="px-4 py-2 rounded-xl bg-[#020813]/80 border border-emerald-500/30 text-xs">
            <span class="text-slate-400">SLA:</span>
            <span class="text-emerald-400 font-bold ml-1.5">99.98% Uptime</span>
          </div>
          <div class="px-4 py-2 rounded-xl bg-[#020813]/80 border border-[#00F0B5]/30 text-xs">
            <span class="text-slate-400">APM Latency:</span>
            <span class="text-[#00F0B5] font-bold ml-1.5">&lt; 2.5ms p50</span>
          </div>
        </div>

      </div>
      
      <!-- SRE Compliance Bar -->
      <div class="mt-6 pt-5 border-t border-slate-800/80 grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs text-slate-300 font-mono">
        <div class="flex items-center gap-2">
          <span class="text-emerald-400 font-bold">✓</span>
          <span>SQLite WAL Zero-Contention Relational Storage</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-[#00F0B5] font-bold">✓</span>
          <span>All 37 Enterprise Static Routes Verified Online</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-emerald-400 font-bold">✓</span>
          <span>Zero Credential Leaks &amp; Passive Thermal Safety</span>
        </div>
      </div>
    </div>

    <!-- Interactive Platform Health Hub -->
    <PlatformHealthHub client:load />

  </div>
</MainLayout>

