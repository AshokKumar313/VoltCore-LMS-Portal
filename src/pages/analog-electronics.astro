---
import MainLayout from '../layouts/MainLayout.astro';
import AnalogElectronicsHub from '../components/AnalogElectronicsHub.jsx';

/**
 * ========================================================================================
 * VoltCore Apex Academia - Phase D: Analog Electronics & Semiconductor Workbench
 * Anna University / MIT Campus - Department of Electronics Engineering (Regulation 2023)
 * Platform Lead: Ashok Kumar A (2023MITEC042)
 * Features 241–250:
 *   - Feature 241: PN Junction Learning Explorer (Vbi, W, peak E-field, junction cap)
 *   - Feature 242: Diode Characteristics Plotter (Shockley equation, dynamic resistance)
 *   - Feature 243: Zener Voltage Regulator Calculator (Rs, Iz, line/load regulation)
 *   - Feature 244: BJT Configuration Comparison Matrix (CB, CE, CC parameters)
 *   - Feature 245: MOSFET Characteristics Plotter (Cutoff, Triode, Saturation, gm, ro)
 *   - Feature 246: Small-Signal CE Amplifier Gain Calculator (Av, Rin, Rout, 3dB cutoff)
 *   - Feature 247: Op-Amp Configuration Explorer (Inverting, Non-inv, Diff, Slew Rate)
 *   - Feature 248: RC/RL Transient Response Calculator (Time constant tau, step curves)
 *   - Feature 249: RLC Resonance Calculator (Series/Parallel f0, Q, BW, damping zeta)
 *   - Feature 250: Semiconductor Material Comparison Tool (Si, Ge, GaAs, GaN, SiC)
 * ========================================================================================
 */

const pageMetadata = {
  title: "Analog Electronics & Semiconductor Tools | VoltCore Apex Academia",
  lead: "Ashok Kumar A",
  rollNo: "2023MITEC042",
  department: "Department of Electronics Engineering",
  campus: "Madras Institute of Technology (MIT) Campus, Anna University",
  regulation: "Regulation 2023",
  mode: "Semiconductors + Diodes + BJT/MOSFET + Op-Amps + RLC Resonance"
};
---

<MainLayout title={pageMetadata.title} activeNav="analog-electronics">
  <div class="space-y-6 font-mono">
    
    <!-- Hero Header Banner -->
    <div class="glass-card-accent rounded-3xl p-6 sm:p-8 border relative overflow-hidden shadow-2xl" style="border-color: var(--theme-border);">
      <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
        
        <div class="flex items-center gap-5">
          <!-- Glass Cybernetic Avatar -->
          <div class="relative w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-gradient-to-tr from-amber-500 via-rose-500 to-cyan-500 p-[2.5px] shadow-emerald-glow flex-shrink-0">
            <div class="w-full h-full bg-slate-950 rounded-[14px] flex items-center justify-center font-bold text-2xl text-amber-400">
              🔬
            </div>
            <span class="absolute -bottom-1 -right-1 h-4 w-4 rounded-full bg-amber-400 ring-4 ring-slate-950 animate-pulse"></span>
          </div>

          <div>
            <div class="flex flex-wrap items-center gap-2">
              <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight font-sans">
                Analog Electronics & Semiconductor Tools
              </h1>
              <span class="px-2.5 py-0.5 rounded-full bg-amber-500/20 text-amber-300 text-xs font-bold border border-amber-500/40">
                PHASE D (FEATURES 241–250)
              </span>
            </div>
            <div class="text-xs sm:text-sm text-slate-300 mt-1">
              {pageMetadata.department} • {pageMetadata.campus}
            </div>
            <div class="text-xs text-slate-400 mt-0.5">
              Platform Architect: <span class="text-white font-bold">{pageMetadata.lead} ({pageMetadata.rollNo})</span> • {pageMetadata.mode}
            </div>
          </div>
        </div>

        <!-- Capability Badges -->
        <div class="flex flex-wrap items-center gap-3">
          <div class="px-4 py-2 rounded-xl bg-slate-900/80 border border-amber-500/30 text-xs">
            <span class="text-slate-400">Semiconductors:</span>
            <span class="text-amber-400 font-bold ml-1.5">Si / Ge / GaAs / GaN / SiC</span>
          </div>
          <div class="px-4 py-2 rounded-xl bg-slate-900/80 border border-emerald-500/30 text-xs">
            <span class="text-slate-400">Transistors:</span>
            <span class="text-emerald-400 font-bold ml-1.5">BJT Matrix & MOSFET I-V</span>
          </div>
          <div class="px-4 py-2 rounded-xl bg-slate-900/80 border border-cyan-500/30 text-xs">
            <span class="text-slate-400">Filter/Resonance:</span>
            <span class="text-cyan-400 font-bold ml-1.5">RC / RL / RLC Q-Factor</span>
          </div>
        </div>

      </div>
    </div>

    <!-- Interactive Analog Electronics Hub Island -->
    <AnalogElectronicsHub client:load />

  </div>
</MainLayout>
