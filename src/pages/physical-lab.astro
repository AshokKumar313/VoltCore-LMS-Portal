---
import MainLayout from '../layouts/MainLayout.astro';
import PhysicalLabBridge from '../components/PhysicalLabBridge.jsx';

// Physical Lab Metadata
const physicalLabMetadata = {
  institution: "Autonomous Engineering Cluster",
  department: "Electronics & Embedded Systems",
  regulation: "Modular Engineering Series",
  lead: "VoltCore Apex",
  rollNo: "Core Series",
  workspace: "Physical Hardware-in-the-Loop (HIL) Lab Automation & Bench Bridge",
  mode: "USB Serial Enumeration, Port Locking, Telemetry Logging & Assertions"
};
---

<MainLayout title={`Physical HIL Lab Automation | ${physicalLabMetadata.lead} (Core Series)`} activeNav="physical-lab">
  <div class="space-y-8 font-mono">
    
    <!-- Hero Physical Lab Header -->
    <div class="glass-card-accent rounded-3xl p-6 sm:p-8 border border-[#00F0B5]/30 relative overflow-hidden shadow-2xl">
      <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
        
        <div class="flex items-center gap-5">
          <!-- Glass Cybernetic Avatar -->
          <div class="relative w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-gradient-to-tr from-[#00693E] to-[#00F0B5] p-[2.5px] shadow-emerald-glow flex-shrink-0">
            <div class="w-full h-full bg-[#020813] rounded-[14px] flex items-center justify-center font-bold text-2xl text-[#00F0B5]">
              🔬
            </div>
            <span class="absolute -bottom-1 -right-1 h-4 w-4 rounded-full bg-emerald-400 ring-4 ring-[#020813] animate-pulse"></span>
          </div>

          <div>
            <div class="flex flex-wrap items-center gap-2">
              <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight font-sans">
                Physical HIL Lab Automation &amp; Bench Bridge
              </h1>
              <span class="px-2.5 py-0.5 rounded-full bg-[#00693E]/50 text-[#00F0B5] text-xs font-bold border border-[#00F0B5]/40">
                PHASE 17 ENTERPRISE
              </span>
            </div>
            <div class="text-xs sm:text-sm text-slate-300 mt-1">
              {physicalLabMetadata.department} • {physicalLabMetadata.institution}
            </div>
            <div class="text-xs text-slate-400 mt-0.5">
              Platform Architect: <span class="text-white font-bold">{physicalLabMetadata.lead} ({physicalLabMetadata.rollNo})</span> • {physicalLabMetadata.workspace}
            </div>
          </div>
        </div>

        <!-- System Capability Badges -->
        <div class="flex flex-wrap items-center gap-3">
          <div class="px-4 py-2 rounded-xl bg-[#020813]/80 border border-emerald-500/30 text-xs">
            <span class="text-slate-400">Workstation:</span>
            <span class="text-emerald-400 font-bold ml-1.5">Lab 304 HIL</span>
          </div>
          <div class="px-4 py-2 rounded-xl bg-[#020813]/80 border border-[#00F0B5]/30 text-xs">
            <span class="text-slate-400">Bridge Mode:</span>
            <span class="text-[#00F0B5] font-bold ml-1.5">Mutex Port Locking</span>
          </div>
          <div class="px-4 py-2 rounded-xl bg-[#020813]/80 border border-cyan-500/30 text-xs">
            <span class="text-slate-400">Data Logger:</span>
            <span class="text-cyan-400 font-bold ml-1.5">SQLite WAL Engine</span>
          </div>
        </div>

      </div>

      <!-- Background Glow Aesthetic -->
      <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-gradient-to-br from-[#00F0B5]/10 to-[#00693E]/20 rounded-full blur-3xl pointer-events-none"></div>
    </div>

    <!-- Interactive Physical Lab Island -->
    <PhysicalLabBridge client:load />

    <!-- Laboratory Protocols & Standards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="p-5 rounded-2xl bg-[#020813]/80 border border-slate-800">
        <div class="flex items-center gap-2 text-emerald-400 text-sm font-bold mb-2">
          <span>🔒</span>
          <h4>Contention-Free Port Locking</h4>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed">
          Enforces thread-safe session locks on physical serial ports (COM3, COM4, COM7), preventing port contention and race conditions when multiple students interact with bench instruments.
        </p>
      </div>

      <div class="p-5 rounded-2xl bg-[#020813]/80 border border-slate-800">
        <div class="flex items-center gap-2 text-cyan-400 text-sm font-bold mb-2">
          <span>⚡</span>
          <h4>Sub-Millivolt Telemetry Logging</h4>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed">
          Samples high-speed dual-channel oscilloscope voltages, loop current, and bus frequencies, computing CRC frame integrity checks persisted in Write-Ahead Logged SQLite tables.
        </p>
      </div>

      <div class="p-5 rounded-2xl bg-[#020813]/80 border border-[#00F0B5]/30">
        <div class="flex items-center gap-2 text-[#00F0B5] text-sm font-bold mb-2">
          <span>🎯</span>
          <h4>Automated Assertion Verification</h4>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed">
          Automatically scores student circuit setups against Modular Engineering Series lab rubrics (rail stability, clock frequency, thermal headroom), awarding XP for valid hardware assertions.
        </p>
      </div>
    </div>

  </div>
</MainLayout>

