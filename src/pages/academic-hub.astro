---
import MainLayout from '../layouts/MainLayout.astro';
import AcademicManagementHub from '../components/AcademicManagementHub.jsx';

// Academic Hub Metadata
const academicMetadata = {
  institution: "Madras Institute of Technology (MIT) Campus, Anna University",
  department: "Department of Electronics Engineering",
  regulation: "Regulation 2023",
  lead: "Ashok Kumar A",
  rollNo: "2023MITEC042",
  workspace: "Intelligent Academic Management Hub & Syllabus Completion Tracker",
  mode: "Smart Calendar + Syllabus DAG Tracker + Prerequisite Verifier + SQLite WAL"
};
---

<MainLayout title={`Academic Management Hub | ${academicMetadata.lead} (MIT Campus)`} activeNav="academic-hub">
  <div class="space-y-8 font-mono">
    
    <!-- Hero Academic Hub Header -->
    <div class="glass-card-accent rounded-3xl p-6 sm:p-8 border border-[#00F0B5]/30 relative overflow-hidden shadow-2xl">
      <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
        
        <div class="flex items-center gap-5">
          <!-- Glass Cybernetic Academic Avatar -->
          <div class="relative w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-gradient-to-tr from-[#00693E] to-[#00F0B5] p-[2.5px] shadow-emerald-glow flex-shrink-0">
            <div class="w-full h-full bg-[#020813] rounded-[14px] flex items-center justify-center font-bold text-2xl text-[#00F0B5]">
              📚
            </div>
            <span class="absolute -bottom-1 -right-1 h-4 w-4 rounded-full bg-emerald-400 ring-4 ring-[#020813] animate-pulse"></span>
          </div>

          <div>
            <div class="flex flex-wrap items-center gap-2">
              <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight font-sans">
                Intelligent Academic Management Hub
              </h1>
              <span class="px-2.5 py-0.5 rounded-full bg-[#00693E]/50 text-[#00F0B5] text-xs font-bold border border-[#00F0B5]/40">
                PHASE 19 ENTERPRISE
              </span>
            </div>
            <div class="text-xs sm:text-sm text-slate-300 mt-1">
              {academicMetadata.department} • {academicMetadata.institution}
            </div>
            <div class="text-xs text-slate-400 mt-0.5">
              Platform Architect: <span class="text-white font-bold">{academicMetadata.lead} ({academicMetadata.rollNo})</span> • {academicMetadata.workspace}
            </div>
          </div>
        </div>

        <!-- System Capability Badges -->
        <div class="flex flex-wrap items-center gap-3">
          <div class="px-4 py-2 rounded-xl bg-[#020813]/80 border border-emerald-500/30 text-xs">
            <span class="text-slate-400">Curriculum:</span>
            <span class="text-emerald-400 font-bold ml-1.5">ECE R2023 Sem 4</span>
          </div>
          <div class="px-4 py-2 rounded-xl bg-[#020813]/80 border border-[#00F0B5]/30 text-xs">
            <span class="text-slate-400">Prerequisites:</span>
            <span class="text-[#00F0B5] font-bold ml-1.5">DAG Enforced</span>
          </div>
          <div class="px-4 py-2 rounded-xl bg-[#020813]/80 border border-cyan-500/30 text-xs">
            <span class="text-slate-400">Calendar:</span>
            <span class="text-cyan-400 font-bold ml-1.5">COE Sync Active</span>
          </div>
        </div>

      </div>

      <!-- Background Glow Aesthetic -->
      <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-gradient-to-br from-[#00F0B5]/10 to-[#00693E]/20 rounded-full blur-3xl pointer-events-none"></div>
    </div>

    <!-- Interactive Academic Hub Dashboard Island -->
    <AcademicManagementHub client:load />

    <!-- Academic Standards & Governance Framework -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="p-5 rounded-2xl bg-[#020813]/80 border border-slate-800">
        <div class="flex items-center gap-2 text-emerald-400 text-sm font-bold mb-2">
          <span>📅</span>
          <h4>Continuous Assessment Synchronization</h4>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed">
          Maintains automated countdowns and venue mapping for IA-1, IA-2, model practicals, and university theory examinations governed by the Anna University Controller of Examinations schedule.
        </p>
      </div>

      <div class="p-5 rounded-2xl bg-[#020813]/80 border border-slate-800">
        <div class="flex items-center gap-2 text-cyan-400 text-sm font-bold mb-2">
          <span>📊</span>
          <h4>Granular Syllabus Progression</h4>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed">
          Tracks curriculum completion down to the individual topic level across EC3352, EC3452, EC3451, and EC3491, recording active study hours and calculating live Course Outcome (CO) attainment metrics.
        </p>
      </div>

      <div class="p-5 rounded-2xl bg-[#020813]/80 border border-[#00F0B5]/30">
        <div class="flex items-center gap-2 text-[#00F0B5] text-sm font-bold mb-2">
          <span>🛡️</span>
          <h4>Prerequisite Dependency Barrier</h4>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed">
          Enforces Directed Acyclic Graph (DAG) sequencing, ensuring foundational concepts (K-Maps, Flip-Flops, Gauss's Law) are verified before unlocking advanced sequential hazards or Maxwell wave equations.
        </p>
      </div>
    </div>

  </div>
</MainLayout>

