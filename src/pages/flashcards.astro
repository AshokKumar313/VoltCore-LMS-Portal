---
import MainLayout from '../layouts/MainLayout.astro';
import SpacedRepetitionFlashcards from '../components/SpacedRepetitionFlashcards.jsx';
---

<MainLayout
  title="SM-2 ECE Spaced Repetition Flashcards | VoltCore Apex Academia"
  description="Master ARM Cortex-M register maps, small-signal hybrid-pi formulas, and RISC-V hazard logic with SuperMemo-2 interval scheduling."
  activeNav="flashcards"
>
  <div class="space-y-6">
    <!-- Breadcrumb & Header -->
    <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-slate-800 text-xs font-mono">
      <div class="flex items-center gap-2 text-slate-400">
        <a href="/" class="hover:text-[#00F0B5] transition-colors">VoltCore</a>
        <span>/</span>
        <span class="text-[#00F0B5]">SM-2 Spaced Repetition</span>
        <span>/</span>
        <span class="text-slate-500">ECE Retention Mastery</span>
      </div>
      <div class="flex items-center gap-3">
        <span class="px-2 py-0.5 rounded bg-amber-500/20 text-amber-400 border border-amber-500/30">
          SuperMemo-2 Active Recall
        </span>
      </div>
    </div>

    <!-- Interactive Flashcards React Component -->
    <SpacedRepetitionFlashcards client:load />
  </div>
</MainLayout>

