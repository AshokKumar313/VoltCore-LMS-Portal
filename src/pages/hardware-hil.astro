---
import MainLayout from '../layouts/MainLayout.astro';
import HwTestBenchLive from '../components/HwTestBenchLive.jsx';
import PeripheralBusHub from '../components/PeripheralBusHub.jsx';
---

<MainLayout
  title="Hardware-in-the-Loop (HIL) Test Bench | VoltCore Apex Academia"
  description="Real-time Hardware-in-the-Loop microcontroller testing dashboard communicating over WebSerial to assert sensor linearity, GPIO loopback propagation delays, and automatic lab ledger scoring."
  activeNav="simulation"
>
  <div class="space-y-6">
    <!-- Breadcrumb & Header -->
    <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-slate-800 text-xs font-mono">
      <div class="flex items-center gap-2 text-slate-400">
        <a href="/" class="hover:text-[#00F0B5] transition-colors">VoltCore</a>
        <span>/</span>
        <a href="/simulation" class="hover:text-[#00F0B5] transition-colors">Hardware Lab</a>
        <span>/</span>
        <span class="text-[#00F0B5]">Hardware-in-the-Loop (HIL)</span>
      </div>
      <div class="flex items-center gap-3">
        <span class="px-2.5 py-1 rounded bg-[#00693E]/30 text-[#00F0B5] border border-[#00F0B5]/30">
          Anna University R2023 Lab Assessment • Auto-Graded
        </span>
      </div>
    </div>

    <!-- HIL Test Bench React Island -->
    <HwTestBenchLive client:load />

    <!-- Phase 36: Peripheral Bus Protocols Analyzer Island -->
    <PeripheralBusHub client:load />
  </div>
</MainLayout>

