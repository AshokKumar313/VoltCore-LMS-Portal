---
import MainLayout from '../layouts/MainLayout.astro';
import CloudDeploymentHub from '../components/CloudDeploymentHub.jsx';

// Cloud Staging Metadata
const cloudDeployMetadata = {
  institution: "Madras Institute of Technology (MIT) Campus, Anna University",
  department: "Department of Electronics Engineering",
  regulation: "Regulation 2023",
  lead: "Ashok Kumar A",
  rollNo: "2023MITEC042",
  workspace: "Cloud Production Staging & Live Container Management",
  mode: "Render.com / Docker Multi-Container, Secret Isolation & SQLite WAL"
};
---

<MainLayout title={`Cloud Staging & Deployment | ${cloudDeployMetadata.lead} (MIT Campus)`} activeNav="cloud-deploy">
  <div class="space-y-8 font-mono">
    
    <!-- Hero Cloud Deployment Header -->
    <div class="glass-card-accent rounded-3xl p-6 sm:p-8 border border-[#00F0B5]/30 relative overflow-hidden shadow-2xl">
      <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
        
        <div class="flex items-center gap-5">
          <!-- Glass Cybernetic Avatar -->
          <div class="relative w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-gradient-to-tr from-[#00693E] to-[#00F0B5] p-[2.5px] shadow-emerald-glow flex-shrink-0">
            <div class="w-full h-full bg-[#020813] rounded-[14px] flex items-center justify-center font-bold text-2xl text-[#00F0B5]">
              ☁️
            </div>
            <span class="absolute -bottom-1 -right-1 h-4 w-4 rounded-full bg-emerald-400 ring-4 ring-[#020813] animate-pulse"></span>
          </div>

          <div>
            <div class="flex flex-wrap items-center gap-2">
              <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight font-sans">
                Cloud Production Staging &amp; Live Deployment
              </h1>
              <span class="px-2.5 py-0.5 rounded-full bg-[#00693E]/50 text-[#00F0B5] text-xs font-bold border border-[#00F0B5]/40">
                PHASE 16 ENTERPRISE
              </span>
            </div>
            <div class="text-xs sm:text-sm text-slate-300 mt-1">
              {cloudDeployMetadata.department} • {cloudDeployMetadata.institution}
            </div>
            <div class="text-xs text-slate-400 mt-0.5">
              Platform Architect: <span class="text-white font-bold">{cloudDeployMetadata.lead} ({cloudDeployMetadata.rollNo})</span> • {cloudDeployMetadata.workspace}
            </div>
          </div>
        </div>

        <!-- System Capability Badges -->
        <div class="flex flex-wrap items-center gap-3">
          <div class="px-4 py-2 rounded-xl bg-[#020813]/80 border border-emerald-500/30 text-xs">
            <span class="text-slate-400">Containers:</span>
            <span class="text-emerald-400 font-bold ml-1.5">Docker 3.8 Spec</span>
          </div>
          <div class="px-4 py-2 rounded-xl bg-[#020813]/80 border border-[#00F0B5]/30 text-xs">
            <span class="text-slate-400">Memory Cap:</span>
            <span class="text-[#00F0B5] font-bold ml-1.5">&lt; 300 MB Working Set</span>
          </div>
          <div class="px-4 py-2 rounded-xl bg-[#020813]/80 border border-cyan-500/30 text-xs">
            <span class="text-slate-400">Region:</span>
            <span class="text-cyan-400 font-bold ml-1.5">Singapore (Low Latency)</span>
          </div>
        </div>

      </div>

      <!-- Background Glow Aesthetic -->
      <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-gradient-to-br from-[#00F0B5]/10 to-[#00693E]/20 rounded-full blur-3xl pointer-events-none"></div>
    </div>

    <!-- Interactive Cloud Deployment Island -->
    <CloudDeploymentHub client:load />

    <!-- DevOps Standards & Production Integrity -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="p-5 rounded-2xl bg-[#020813]/80 border border-slate-800">
        <div class="flex items-center gap-2 text-emerald-400 text-sm font-bold mb-2">
          <span>🔒</span>
          <h4>Zero-Leak Secret Isolation</h4>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed">
          Restricted admin credentials are bound solely to secure cloud environment variables with RBAC access control. Client bundles are scanned to verify 0 unredacted exposures.
        </p>
      </div>

      <div class="p-5 rounded-2xl bg-[#020813]/80 border border-slate-800">
        <div class="flex items-center gap-2 text-cyan-400 text-sm font-bold mb-2">
          <span>💾</span>
          <h4>SQLite WAL Cloud Persistence</h4>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed">
          Write-Ahead Logging mode enables non-blocking read-write concurrency on persistent cloud SSD volumes, with automated 5000ms busy timeouts and normal synchronization.
        </p>
      </div>

      <div class="p-5 rounded-2xl bg-[#020813]/80 border border-[#00F0B5]/30">
        <div class="flex items-center gap-2 text-[#00F0B5] text-sm font-bold mb-2">
          <span>⚡</span>
          <h4>Lightweight Thermal Boundary</h4>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed">
          Enforces memory limits (API: 256MB, Redis: 64MB, Nginx: 128MB) to preserve passive cooling on local development workstations and fit cleanly in cloud free/starter tiers.
        </p>
      </div>
    </div>

  </div>
</MainLayout>
