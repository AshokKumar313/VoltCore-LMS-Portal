---
import MainLayout from '../layouts/MainLayout.astro';
import IoTConnectedSystemsHub from '../components/IoTConnectedSystemsHub.jsx';

/**
 * ========================================================================================
 * VoltCore Apex Academia - Phase G: IoT & Connected Systems Hub
 * Anna University / MIT Campus - Department of Electronics Engineering (Regulation 2023)
 * Platform Lead: Ashok Kumar A (2023MITEC042)
 * Features 271–280:
 *   - Feature 271: IoT Architecture Diagram Builder (Perception, Edge, Network, Cloud, App)
 *   - Feature 272: MQTT Message Structure Explorer (Fixed/Variable Headers, QoS 0/1/2 Handshakes)
 *   - Feature 273: Sensor Data Dashboard with Anomaly Detection (Z-Score & Thresholds)
 *   - Feature 274: IoT Device Registry (ESP32, STM32-LoRa, RP2040, nRF52 Inventory)
 *   - Feature 275: Virtual Sensor Calibration Tool (2-Point Linear, Temp Compensation)
 *   - Feature 276: MQTT Topic Structure Designer (Hierarchical Paths & Wildcard Matcher)
 *   - Feature 277: IoT Packet History Ledger (CONNECT, PUBLISH, SUBSCRIBE, RSSI, SNR)
 *   - Feature 278: Device Status Timeline Generator (Boot, Wi-Fi, MQTT Handshake, Sleep)
 *   - Feature 279: Smart Home / Industrial Automation Rule Engine (IF-THEN Trigger Engine)
 *   - Feature 280: IoT Network Topology Visualizer & Link Budget (Star, Mesh, Path Loss)
 * ========================================================================================
 */

const pageMetadata = {
  title: "IoT & Connected Systems Hub | VoltCore Apex Academia",
  lead: "VoltCore Apex",
  rollNo: "Core Series",
  department: "Electronics & Embedded Systems",
  campus: "Autonomous Engineering Cluster",
  regulation: "Modular Engineering Series",
  mode: "Edge-to-Cloud Telemetry & MQTT Brokering"
};
---

<MainLayout title={pageMetadata.title} activeNav="iot-connected-systems">
  <div class="space-y-6 font-mono">
    
    <!-- Hero Header Banner -->
    <div class="glass-card-accent rounded-3xl p-6 sm:p-8 border relative overflow-hidden shadow-2xl" style="border-color: var(--theme-border);">
      <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
        
        <div class="flex items-center gap-5">
          <!-- Glass Cybernetic Avatar -->
          <div class="relative w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-gradient-to-tr from-cyan-500 via-teal-500 to-emerald-500 p-[2.5px] shadow-emerald-glow flex-shrink-0">
            <div class="w-full h-full bg-slate-950 rounded-[14px] flex items-center justify-center font-bold text-2xl text-cyan-400">
              🌐
            </div>
            <span class="absolute -bottom-1 -right-1 h-4 w-4 rounded-full bg-cyan-400 ring-4 ring-slate-950 animate-pulse"></span>
          </div>

          <div>
            <div class="flex flex-wrap items-center gap-2">
              <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight font-sans">
                IoT & Connected Systems Hub
              </h1>
              <span class="px-2.5 py-0.5 rounded-full bg-cyan-500/20 text-cyan-300 text-xs font-bold border border-cyan-500/40">
                PHASE G (FEATURES 271–280)
              </span>
            </div>
            <div class="text-xs sm:text-sm text-slate-300 mt-1">
              {pageMetadata.department} • {pageMetadata.campus}
            </div>
            <div class="text-xs text-slate-400 mt-0.5">
              Platform Architect: <span class="text-white font-bold">{pageMetadata.lead} ({pageMetadata.rollNo})</span> • {pageMetadata.mode}
            </div>
          </div>
        </div>

        <!-- Capability Badges -->
        <div class="flex flex-wrap items-center gap-3">
          <div class="px-4 py-2 rounded-xl bg-slate-900/80 border border-cyan-500/30 text-xs">
            <span class="text-slate-400">IoT Stack:</span>
            <span class="text-cyan-400 font-bold ml-1.5">5-Tier Architecture</span>
          </div>
          <div class="px-4 py-2 rounded-xl bg-slate-900/80 border border-teal-500/30 text-xs">
            <span class="text-slate-400">Messaging:</span>
            <span class="text-teal-400 font-bold ml-1.5">MQTT 3.1.1 / QoS 0–2</span>
          </div>
          <div class="px-4 py-2 rounded-xl bg-slate-900/80 border border-emerald-500/30 text-xs">
            <span class="text-slate-400">Intelligence:</span>
            <span class="text-emerald-400 font-bold ml-1.5">Z-Score & IF-THEN Rules</span>
          </div>
        </div>

      </div>
    </div>

    <!-- Interactive IoT Connected Systems Hub Island -->
    <IoTConnectedSystemsHub client:load />

  </div>
</MainLayout>
