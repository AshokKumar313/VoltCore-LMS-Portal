---
import MainLayout from '../layouts/MainLayout.astro';
import SecurityAuditDashboard from '../components/SecurityAuditDashboard.jsx';

// Security Hub Metadata
const securityMetadata = {
  institution: "Madras Institute of Technology (MIT) Campus, Anna University",
  department: "Department of Electronics Engineering",
  regulation: "Regulation 2023",
  lead: "Ashok Kumar A",
  rollNo: "2023MITEC042",
  workspace: "Security Operations Center (SOC) & Infrastructure Hardening",
  mode: "MFA / TOTP Enforcement, SHA-256 Audit Trail & SQLite WAL Recovery"
};
---

<MainLayout title={`Security Hardening & SOC Audit | ${securityMetadata.lead} (MIT Campus)`} activeNav="security-hub">
  <div class="space-y-8 font-mono">
    
    <!-- Hero Security SOC Header -->
    <div class="glass-card-accent rounded-3xl p-6 sm:p-8 border border-[#00F0B5]/30 relative overflow-hidden shadow-2xl">
      <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
        
        <div class="flex items-center gap-5">
          <!-- Glass Security Avatar -->
          <div class="relative w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-gradient-to-tr from-[#00693E] to-[#00F0B5] p-[2.5px] shadow-emerald-glow flex-shrink-0">
            <div class="w-full h-full bg-[#020813] rounded-[14px] flex items-center justify-center font-bold text-2xl text-[#00F0B5]">
              🛡️
            </div>
            <span class="absolute -bottom-1 -right-1 h-4 w-4 rounded-full bg-emerald-400 ring-4 ring-[#020813] animate-pulse"></span>
          </div>

          <div>
            <div class="flex flex-wrap items-center gap-2">
              <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight font-sans">
                Security Hardening & SOC Audit Center
              </h1>
              <span class="px-2.5 py-0.5 rounded-full bg-[#00693E]/50 text-[#00F0B5] text-xs font-bold border border-[#00F0B5]/40">
                PHASE 14 ENTERPRISE
              </span>
            </div>
            <div class="text-xs sm:text-sm text-slate-300 mt-1">
              {securityMetadata.department} • {securityMetadata.institution}
            </div>
            <div class="text-xs text-slate-400 mt-0.5">
              Platform Architect: <span class="text-white font-bold">{securityMetadata.lead} ({securityMetadata.rollNo})</span> • {securityMetadata.workspace}
            </div>
          </div>
        </div>

        <!-- Security Status Pills -->
        <div class="flex flex-wrap items-center gap-3">
          <div class="px-4 py-2 rounded-xl bg-[#020813]/80 border border-emerald-500/30 text-xs">
            <span class="text-slate-400">Standard:</span>
            <span class="text-emerald-400 font-bold ml-1.5">OWASP 2024 / IEEE 802.1X</span>
          </div>
          <div class="px-4 py-2 rounded-xl bg-[#020813]/80 border border-[#00F0B5]/30 text-xs">
            <span class="text-slate-400">MFA Mode:</span>
            <span class="text-[#00F0B5] font-bold ml-1.5">TOTP-HMAC-SHA256</span>
          </div>
          <div class="px-4 py-2 rounded-xl bg-[#020813]/80 border border-cyan-500/30 text-xs">
            <span class="text-slate-400">Audit Ledger:</span>
            <span class="text-cyan-400 font-bold ml-1.5">SHA-256 Chained</span>
          </div>
        </div>

      </div>

      <!-- Background Glow Aesthetic -->
      <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-gradient-to-br from-[#00F0B5]/10 to-[#00693E]/20 rounded-full blur-3xl pointer-events-none"></div>
    </div>

    <!-- Interactive Security Hardening Island -->
    <SecurityAuditDashboard client:load />

    <!-- Infrastructure Hardening & Privacy Protocols -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="p-5 rounded-2xl bg-[#020813]/80 border border-slate-800">
        <div class="flex items-center gap-2 text-emerald-400 text-sm font-bold mb-2">
          <span>🔐</span>
          <h4>Multi-Factor Authentication (MFA)</h4>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed">
          RFC 6238 compliant 6-digit TOTP verification with time-drift tolerance protects privileged admin and faculty access without third-party vendor lock-in.
        </p>
      </div>

      <div class="p-5 rounded-2xl bg-[#020813]/80 border border-slate-800">
        <div class="flex items-center gap-2 text-cyan-400 text-sm font-bold mb-2">
          <span>🛡️</span>
          <h4>Fine-Grained RBAC Boundaries</h4>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed">
          Enforces least-privilege authorization barriers across all API endpoints. Unauthorized privilege escalation attempts trigger immutable security events.
        </p>
      </div>

      <div class="p-5 rounded-2xl bg-[#020813]/80 border border-slate-800">
        <div class="flex items-center gap-2 text-[#00F0B5] text-sm font-bold mb-2">
          <span>💾</span>
          <h4>Atomic Disaster Recovery</h4>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed">
          SQLite Write-Ahead Logging (WAL) snapshot engine generates hot backups on demand, validates SQLite page integrity, and computes SHA-256 checksums.
        </p>
      </div>
    </div>

  </div>
</MainLayout>

