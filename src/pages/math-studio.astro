---
import MainLayout from '../layouts/MainLayout.astro';
import MathStudioHub from '../components/MathStudioHub.jsx';
---

<MainLayout
  title="Engineering Mathematics Studio | VoltCore Apex Academia"
  description="Interactive Laplace s-domain and discrete z-domain pole-zero solver, Hurwitz/Schur-Cohn stability analyzer, Bode plot animator, Runge-Kutta RK4 transient synthesizer, and Fourier series harmonic reconstruction."
  activeNav="simulation"
>
  <div class="space-y-6">
    {/* Breadcrumb & Navigation Header */}
    <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-slate-800 text-xs font-mono">
      <div class="flex items-center gap-2 text-slate-400">
        <a href="/" class="hover:text-[#00F0B5] transition-colors">VoltCore</a>
        <span>/</span>
        <a href="/simulation" class="hover:text-[#00F0B5] transition-colors">Simulation Lab</a>
        <span>/</span>
        <span class="text-[#00F0B5]">Engineering Math Studio</span>
      </div>
      <div class="flex items-center gap-3">
        <span class="px-2.5 py-1 rounded bg-cyan-950/40 text-cyan-400 border border-cyan-500/30">
          Complex Plane Pole-Zero Solver • Laplace / Z-Domain • Fourier Harmonics
        </span>
      </div>
    </div>

    {/* Math Studio React Component */}
    <MathStudioHub client:load />
  </div>
</MainLayout>
