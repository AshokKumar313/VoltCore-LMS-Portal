---
import MainLayout from '../layouts/MainLayout.astro';
import LiveTelemetryStream from '../components/LiveTelemetryStream.jsx';
---

<MainLayout
  title="Real-Time Hardware Telemetry Stream | VoltCore Apex Academia"
  description="Real-time Server-Sent Events (SSE) telemetry gateway streaming ESP32 RFID scans, student XP dispatches, fleet heartbeats, and TinyML vibration anomalies."
  activeNav="telemetry"
>
  <div class="space-y-6">
    <!-- Breadcrumb & Header -->
    <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-slate-800 text-xs font-mono">
      <div class="flex items-center gap-2 text-slate-400">
        <a href="/" class="hover:text-[#00F0B5] transition-colors">VoltCore</a>
        <span>/</span>
        <span class="text-[#00F0B5]">Hardware Telemetry</span>
        <span>/</span>
        <span class="text-slate-500">Live SSE Stream</span>
      </div>
      <div class="flex items-center gap-3">
        <span class="px-2.5 py-1 rounded bg-[#00693E]/30 text-[#00F0B5] border border-[#00F0B5]/30">
          SSE Port 5000 /api/telemetry/stream
        </span>
      </div>
    </div>

    <!-- Live Telemetry Stream React Component -->
    <LiveTelemetryStream client:load />
  </div>
</MainLayout>

