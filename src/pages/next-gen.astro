---
import MainLayout from '../layouts/MainLayout.astro';
import NextGenInnovationHub from '../components/NextGenInnovationHub.jsx';

// Next-Gen Innovations Metadata
const nextGenMetadata = {
  institution: "Madras Institute of Technology (MIT) Campus, Anna University",
  department: "Department of Electronics Engineering",
  regulation: "Anna University Regulation 2023",
  lead: "Ashok Kumar A",
  rollNo: "2023MITEC042",
  workspace: "Autonomous AI Academic Agent & Core Hardware Innovations",
  mode: "Smart Syllabus Recommendations, Lab Diagnostics & Digital Twin"
};
---

<MainLayout title={`Next-Gen Innovations & AI Agent | ${nextGenMetadata.lead} (Core Series)`} activeNav="next-gen">
  <div class="space-y-8 font-mono">
    
    <!-- Hero Next-Gen Innovations Header -->
    <div class="glass-card-accent rounded-3xl p-6 sm:p-8 border border-[#00F0B5]/30 relative overflow-hidden shadow-2xl">
      <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
        
        <div class="flex items-center gap-5">
          <!-- Glass Cybernetic Avatar -->
          <div class="relative w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-gradient-to-tr from-[#00693E] to-[#00F0B5] p-[2.5px] shadow-emerald-glow flex-shrink-0">
            <div class="w-full h-full bg-[#020813] rounded-[14px] flex items-center justify-center font-bold text-2xl text-[#00F0B5]">
              ⚡
            </div>
            <span class="absolute -bottom-1 -right-1 h-4 w-4 rounded-full bg-emerald-400 ring-4 ring-[#020813] animate-pulse"></span>
          </div>

          <div>
            <div class="flex flex-wrap items-center gap-2">
              <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight font-sans">
                Next-Gen Innovations &amp; Autonomous AI Agent
              </h1>
              <span class="px-2.5 py-0.5 rounded-full bg-[#00693E]/50 text-[#00F0B5] text-xs font-bold border border-[#00F0B5]/40">
                PHASE 15 ENTERPRISE
              </span>
            </div>
            <div class="text-xs sm:text-sm text-slate-300 mt-1">
              {nextGenMetadata.department} • {nextGenMetadata.institution}
            </div>
            <div class="text-xs text-slate-400 mt-0.5">
              Platform Architect: <span class="text-white font-bold">{nextGenMetadata.lead} ({nextGenMetadata.rollNo})</span> • {nextGenMetadata.workspace}
            </div>
          </div>
        </div>

        <!-- System Capability Badges -->
        <div class="flex flex-wrap items-center gap-3">
          <div class="px-4 py-2 rounded-xl bg-[#020813]/80 border border-emerald-500/30 text-xs">
            <span class="text-slate-400">Curriculum:</span>
            <span class="text-emerald-400 font-bold ml-1.5">AU R2023 ECE</span>
          </div>
          <div class="px-4 py-2 rounded-xl bg-[#020813]/80 border border-[#00F0B5]/30 text-xs">
            <span class="text-slate-400">Agent Mode:</span>
            <span class="text-[#00F0B5] font-bold ml-1.5">Autonomous Graph</span>
          </div>
          <div class="px-4 py-2 rounded-xl bg-[#020813]/80 border border-cyan-500/30 text-xs">
            <span class="text-slate-400">Digital Twin:</span>
            <span class="text-cyan-400 font-bold ml-1.5">Lab 304 Telemetry</span>
          </div>
        </div>

      </div>

      <!-- Background Glow Aesthetic -->
      <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-gradient-to-br from-[#00F0B5]/10 to-[#00693E]/20 rounded-full blur-3xl pointer-events-none"></div>
    </div>

    <!-- Interactive Next-Gen Innovation Island -->
    <NextGenInnovationHub client:load />

    <!-- Academic Integrity & Innovation Standards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="p-5 rounded-2xl bg-[#020813]/80 border border-slate-800">
        <div class="flex items-center gap-2 text-emerald-400 text-sm font-bold mb-2">
          <span>🧠</span>
          <h4>Pedagogical Prerequisite Reasoning</h4>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed">
          The autonomous agent enforces strict Modular Engineering Curriculum dependency chains, ensuring foundational embedded RTOS and analog hardware mastery before unlocking high-speed DMA or TinyML.
        </p>
      </div>

      <div class="p-5 rounded-2xl bg-[#020813]/80 border border-slate-800">
        <div class="flex items-center gap-2 text-cyan-400 text-sm font-bold mb-2">
          <span>🔍</span>
          <h4>Hardware-in-the-Loop Diagnostics</h4>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed">
          Root cause analysis combines register-level introspection (TIMG, DMA_SxFCR, I2C_SR) with oscilloscope probe instructions to resolve real bench faults during student laboratory sessions.
        </p>
      </div>

      <div class="p-5 rounded-2xl bg-[#020813]/80 border border-[#00F0B5]/30">
        <div class="flex items-center gap-2 text-[#00F0B5] text-sm font-bold mb-2">
          <span>🎯</span>
          <h4>Predictive Core Industry Trajectory</h4>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed">
          Maps experimental laboratory performance directly to Tier-1 core hardware hiring standards across automotive AUTOSAR, semiconductor VLSI verification, and defense avionics domains.
        </p>
      </div>
    </div>

  </div>
</MainLayout>

