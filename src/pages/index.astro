<script>
  // Dynamic Attendance Scans Polling from Flask Server (Port 5000)
  const refreshBtn = document.getElementById('refresh-attendance-btn');
  const tableBody = document.getElementById('attendance-table-body');

  async function fetchLiveAttendance() {
    try {
      const res = await fetch('http://127.0.0.1:5000/api/attendance?limit=10');
      if (!res.ok) return;
      const data = await res.json();
      if (!data.data || !Array.isArray(data.data) || !tableBody) return;

      tableBody.innerHTML = '';
      data.data.forEach((row: any) => {
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-[#041026]/80 text-slate-200 transition-colors';
        tr.innerHTML = `
          <td class="py-2.5 px-3 text-slate-400 font-mono">${row.timestamp}</td>
          <td class="py-2.5 px-3 font-bold text-white font-mono">${row.user_id}</td>
          <td class="py-2.5 px-3 text-[#00F0B5] font-semibold">${row.name || 'Student'}</td>
          <td class="py-2.5 px-3 font-mono"><span class="px-1.5 py-0.5 rounded bg-[#020813] border border-slate-700 text-slate-300">${row.rfid_uid}</span></td>
          <td class="py-2.5 px-3 text-slate-400 font-mono">${row.node_id}</td>
          <td class="py-2.5 px-3 font-mono"><span class="px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 text-[10px] font-bold">✓ ${row.status}</span></td>
        `;
        tableBody.appendChild(tr);
      });
    } catch (e) {
      // In offline/static mode, default table rows persist smoothly
      console.log('Attendance API polling standby:', e);
    }
  }

  refreshBtn?.addEventListener('click', () => {
    fetchLiveAttendance();
  });

  // Auto-poll periodically every 10 seconds
  setInterval(fetchLiveAttendance, 10000);
</script>

