---
import MainLayout from '../layouts/MainLayout.astro';
import WokwiSandbox from '../components/WokwiSandbox.astro';
import XPProgressionWidget from '../components/XPProgressionWidget.jsx';
import EceCourseworkGrid from '../components/EceCourseworkGrid.jsx';

// Student Profile Constants for MIT Campus, Anna University
const student = {
  name: "Ashok Kumar A",
  rollNo: "2023MITEC042",
  department: "Department of Electronics Engineering",
  campus: "Madras Institute of Technology (MIT) Campus, Anna University",
  rfidUid: "E2 80 6F 3B",
  streak: 14,
  xp: 4850,
  level: "Silicon Grandmaster (Level 18)",
  specialization: "Embedded Systems & Real-Time IoT Systems"
};
---

<MainLayout title="VoltCore Apex Academia | Anna University MIT Campus" ieeeMode={true}>
  
  <!-- Hero Section with German Precision Technical HUD -->
  <section class="mb-10 relative">
    <div class="glass-card-accent rounded-3xl p-6 sm:p-8 border border-[#00F0B5]/30 relative overflow-hidden shadow-2xl">
      
      <!-- Ambient Lighting Accent -->
      <div class="absolute -top-24 -right-24 w-96 h-96 bg-gradient-to-br from-[#00F0B5]/20 to-transparent rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
        <div class="max-w-2xl space-y-3">
          
          <div class="flex flex-wrap items-center gap-2">
            <span class="jewel-badge-olive">
              <span class="h-1.5 w-1.5 rounded-full bg-olive-400 animate-pulse"></span>
              Anna University ECE R2023
            </span>
            <span class="jewel-badge-mustard">
              MIT Campus Chromepet
            </span>
            <span class="px-2 py-0.5 rounded-md bg-emerald-500/20 text-[#00F0B5] text-xs font-mono">
              EC8702 • Lab 304
            </span>
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
            VoltCore <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#00F0B5] via-emerald-400 to-cyan-300">Apex Academia</span>
          </h1>

          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
            Elite Embedded Systems & IoT Engineering Learning Management Platform. Bridging physical microcontrollers with real-time telemetry, zero-latency Wokwi simulation, and Gemini AI viva voce mentorship.
          </p>

          <!-- System Badges & Telemetry -->
          <div class="pt-2 flex flex-wrap items-center gap-4 text-xs font-mono text-slate-400">
            <div class="flex items-center gap-1.5">
              <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
              <span class="text-slate-200">PBKDF2-SHA256 (260,000 iters)</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="h-2 w-2 rounded-full bg-cyan-400"></span>
              <span class="text-slate-200">ESP32 REST Gateway (Port 5000)</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="h-2 w-2 rounded-full bg-amber-400"></span>
              <span class="text-slate-200">Zero-Latency Wokwi SPI/I2C</span>
            </div>
          </div>

          <!-- Phase 41 Multi-Frame Studio & 18 Themes CTA -->
          <div class="pt-2 flex flex-wrap items-center gap-3">
            <a
              href="/workspace"
              class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-emerald-500 via-teal-500 to-cyan-500 hover:from-emerald-400 hover:to-cyan-400 text-slate-950 font-bold font-mono text-xs transition-all shadow-lg flex items-center gap-2 group"
            >
              <span>🖥️ Launch Multi-Frame Studio & 18 Themes</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>

            <a
              href="/learning-dashboard"
              class="px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-cyan-300 hover:text-white border border-cyan-500/40 font-bold font-mono text-xs transition-all shadow-md flex items-center gap-2 group"
            >
              <span>📊 Phase A: Learning Dashboard & Path</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>

            <a
              href="/textbook-library"
              class="px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-amber-300 hover:text-white border border-amber-500/40 font-bold font-mono text-xs transition-all shadow-md flex items-center gap-2 group"
            >
              <span>📖 Phase B: Textbooks & Datasheets</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>

            <a
              href="/digital-logic"
              class="px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-cyan-300 hover:text-white border border-cyan-500/40 font-bold font-mono text-xs transition-all shadow-md flex items-center gap-2 group"
            >
              <span>⚡ Phase C: Digital Logic & 4-Var K-Map</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>

            <a
              href="/analog-electronics"
              class="px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-amber-300 hover:text-white border border-amber-500/40 font-bold font-mono text-xs transition-all shadow-md flex items-center gap-2 group"
            >
              <span>🔬 Phase D: Analog Electronics & Semiconductors</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>

            <a
              href="/signals-communication"
              class="px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-indigo-300 hover:text-white border border-indigo-500/40 font-bold font-mono text-xs transition-all shadow-md flex items-center gap-2 group"
            >
              <span>📡 Phase E: Signals & Communication Systems</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>

            <a
              href="/embedded-systems"
              class="px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-cyan-300 hover:text-white border border-cyan-500/40 font-bold font-mono text-xs transition-all shadow-md flex items-center gap-2 group"
            >
              <span>⚡ Phase F: Embedded Systems & Microcontrollers</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>

            <a
              href="/iot-connected-systems"
              class="px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-teal-300 hover:text-white border border-teal-500/40 font-bold font-mono text-xs transition-all shadow-md flex items-center gap-2 group"
            >
              <span>🌐 Phase G: IoT & Connected Systems</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>

            <a
              href="/practical-laboratory"
              class="px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-amber-300 hover:text-white border border-amber-500/40 font-bold font-mono text-xs transition-all shadow-md flex items-center gap-2 group"
            >
              <span>🔬 Phase H: Practical Laboratory Learning</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>

            <a
              href="/ai-assisted-learning"
              class="px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-blue-300 hover:text-white border border-blue-500/40 font-bold font-mono text-xs transition-all shadow-md flex items-center gap-2 group"
            >
              <span>🧠 Phase I: AI-Assisted Learning</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>

            <a
              href="/research-innovation"
              class="px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-emerald-300 hover:text-white border border-emerald-500/40 font-bold font-mono text-xs transition-all shadow-md flex items-center gap-2 group"
            >
              <span>💡 Phase J: Research & Innovation</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>

            <a
              href="/student-projects"
              class="px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-cyan-300 hover:text-white border border-cyan-500/40 font-bold font-mono text-xs transition-all shadow-md flex items-center gap-2 group"
            >
              <span>🛠️ Phase K: Student Projects & Portfolios</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>

            <a
              href="/career-professional"
              class="px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-teal-300 hover:text-white border border-teal-500/40 font-bold font-mono text-xs transition-all shadow-md flex items-center gap-2 group"
            >
              <span>💼 Phase L: Career & Professional Dev</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>

            <a
              href="/collaboration-community"
              class="px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-cyan-300 hover:text-white border border-cyan-500/40 font-bold font-mono text-xs transition-all shadow-md flex items-center gap-2 group"
            >
              <span>🤝 Phase M: Collaboration & Community</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>

            <a
              href="/accessibility-multilingual"
              class="px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-emerald-300 hover:text-white border border-emerald-500/40 font-bold font-mono text-xs transition-all shadow-md flex items-center gap-2 group"
            >
              <span>🌐 Phase N: Accessibility & Multilingual</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>

            <a
              href="/faculty-admin"
              class="px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-teal-300 hover:text-white border border-teal-500/40 font-bold font-mono text-xs transition-all shadow-md flex items-center gap-2 group"
            >
              <span>🏛️ Phase O: Faculty & Admin Management</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>

            <a
              href="/accreditation-compliance"
              class="px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-emerald-300 hover:text-white border border-emerald-500/40 font-bold font-mono text-xs transition-all shadow-md flex items-center gap-2 group"
            >
              <span>🏅 Phase P: Accreditation & Compliance</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>

            <a
              href="/security-integrity"
              class="px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-emerald-300 hover:text-white border border-emerald-500/40 font-bold font-mono text-xs transition-all shadow-md flex items-center gap-2 group"
            >
              <span>🛡️ Phase Q: Security, Auth & System Integrity</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>

            <a
              href="/performance-optimization"
              class="px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-emerald-300 hover:text-white border border-emerald-500/40 font-bold font-mono text-xs transition-all shadow-md flex items-center gap-2 group"
            >
              <span>⚡ Phase R: Performance, Optimization & Caching</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>

            <a
              href="/system-health-integration"
              class="px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-emerald-300 hover:text-white border border-emerald-500/40 font-bold font-mono text-xs transition-all shadow-md flex items-center gap-2 group"
            >
              <span>🚀 Phase S: System Health & 400th Capstone</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>
          </div>
        </div>

        <!-- Student Persona Quick Dashboard -->
        <div class="glass-card p-5 rounded-2xl border border-[#00F0B5]/30 min-w-[280px] lg:max-w-xs space-y-3 font-mono text-xs shadow-xl">
          <div class="flex items-center justify-between pb-2 border-b border-slate-800">
            <span class="text-slate-400">STUDENT PROFILE</span>
            <span class="text-emerald-400 flex items-center gap-1 font-bold">
              <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span> ACTIVE LAB
            </span>
          </div>

          <div>
            <div class="text-base font-bold text-white">{student.name}</div>
            <div class="text-slate-400 text-[11px]">{student.rollNo} • ECE Dept</div>
            <div class="text-[#00F0B5] text-[11px] font-semibold mt-0.5">{student.level}</div>
          </div>

          <div class="pt-2 border-t border-slate-800 space-y-1.5 text-[11px]">
            <div class="flex justify-between">
              <span class="text-slate-400">RFID Token:</span>
              <span class="text-[#00F0B5] font-bold bg-[#020813] px-1.5 py-0.5 rounded border border-[#00F0B5]/20">{student.rfidUid}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-400">Lab Streak:</span>
              <span class="text-amber-400 font-bold">🔥 {student.streak} Days</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-400">XP Points:</span>
              <span class="text-white font-bold">{student.xp} / 5,000 XP</span>
            </div>
          </div>

          <button
            type="button"
            onclick="document.getElementById('open-gemini-drawer-btn')?.click()"
            class="w-full mt-2 py-2 rounded-xl bg-[#00693E]/50 hover:bg-[#00693E] text-[#00F0B5] hover:text-white border border-[#00F0B5]/30 font-bold transition-all flex items-center justify-center gap-1.5"
          >
            <span>Ask Gemini AI Viva Tutor</span>
          </button>
        </div>

      </div>
    </div>
  </section>

  <!-- Section: ECE Coursework Grid & Live Assessment Center (Phase 31) -->
  <section class="mb-12">
    <EceCourseworkGrid client:load />
  </section>

  <!-- Section: Real-Time XP & Curriculum Modules Progression Widget -->
  <section class="mb-12">
    <div class="flex items-center justify-between mb-4">
      <div class="flex items-center gap-3">
        <div class="w-2.5 h-6 bg-gradient-to-b from-[#00693E] to-[#00F0B5] rounded-full"></div>
        <h2 class="text-xl font-bold text-white tracking-tight font-mono">
          Gamified XP Progression & Anna University Module Hub
        </h2>
      </div>
      <span class="text-xs font-mono text-[#00F0B5] hidden sm:inline">
        ⚡ 2.5x Boost Active • SQLite Real-Time Sync
      </span>
    </div>
    <XPProgressionWidget client:load />
  </section>

  <!-- Section 1: Zero-Latency Hardware Sandbox -->
  <section class="mb-12">
    <div class="flex items-center justify-between mb-4">
      <div class="flex items-center gap-3">
        <div class="w-2.5 h-6 bg-gradient-to-b from-[#00693E] to-[#00F0B5] rounded-full"></div>
        <h2 class="text-xl font-bold text-white tracking-tight font-mono">
          Interactive Hardware Simulation Sandbox
        </h2>
      </div>
      <span class="text-xs font-mono text-slate-400 hidden sm:inline">
        Wokwi Live Engine • diagram.json & ESP32 C++
      </span>
    </div>

    <!-- Wokwi Sandbox Component -->
    <WokwiSandbox />
  </section>

  <!-- Section 2: Live ESP32 Hardware Attendance Telemetry Feed -->
  <section class="mb-12">
    <div class="glass-card rounded-2xl p-6 border border-[#00F0B5]/20 space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-slate-800">
        <div>
          <div class="flex items-center gap-2">
            <h3 class="text-lg font-bold text-white font-mono">
              Live ESP32 RFID Attendance Gateway
            </h3>
            <span class="px-2 py-0.5 rounded bg-emerald-500/20 text-[#00F0B5] text-[10px] font-mono border border-[#00F0B5]/30">
              REST: Port 5000
            </span>
          </div>
          <p class="text-xs text-slate-400 font-mono mt-0.5">
            Streaming student RFID card scans from ESP32-WROOM-32 via HTTP POST JSON
          </p>
        </div>

        <div class="flex items-center gap-3 font-mono text-xs">
          <button
            type="button"
            id="refresh-attendance-btn"
            class="px-3 py-1.5 rounded-lg bg-[#041026] hover:bg-[#020813] border border-[#00F0B5]/30 text-slate-200 hover:text-[#00F0B5] transition-all flex items-center gap-1.5"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"/>
            </svg>
            <span>Refresh Scan Log</span>
          </button>
        </div>
      </div>

      <!-- Live Scans Table -->
      <div class="overflow-x-auto">
        <table class="w-full text-left font-mono text-xs">
          <thead>
            <tr class="text-slate-400 border-b border-slate-800 text-[11px]">
              <th class="py-2.5 px-3">TIMESTAMP</th>
              <th class="py-2.5 px-3">STUDENT ID</th>
              <th class="py-2.5 px-3">STUDENT NAME</th>
              <th class="py-2.5 px-3">RFID UID TOKEN</th>
              <th class="py-2.5 px-3">NODE ID</th>
              <th class="py-2.5 px-3">VERIFICATION</th>
            </tr>
          </thead>
          <tbody id="attendance-table-body" class="divide-y divide-slate-800/60">
            <!-- Default Seed Rows -->
            <tr class="hover:bg-[#041026]/80 text-slate-200">
              <td class="py-2.5 px-3 text-slate-400">2026-11-04 15:22:46</td>
              <td class="py-2.5 px-3 font-bold text-white">2023MITEC042</td>
              <td class="py-2.5 px-3 text-[#00F0B5] font-semibold">Ashok Kumar A</td>
              <td class="py-2.5 px-3"><span class="px-1.5 py-0.5 rounded bg-[#020813] border border-slate-700 text-slate-300">E2 80 6F 3B</span></td>
              <td class="py-2.5 px-3 text-slate-400">ESP32_MIT_IOT_LAB_01</td>
              <td class="py-2.5 px-3"><span class="px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 text-[10px] font-bold">✓ Lab-Verified (+50 XP)</span></td>
            </tr>
            <tr class="hover:bg-[#041026]/80 text-slate-200">
              <td class="py-2.5 px-3 text-slate-400">2026-11-04 15:20:10</td>
              <td class="py-2.5 px-3 font-bold text-white">2023MITEC015</td>
              <td class="py-2.5 px-3 text-[#00F0B5] font-semibold">Kavitha Raman</td>
              <td class="py-2.5 px-3"><span class="px-1.5 py-0.5 rounded bg-[#020813] border border-slate-700 text-slate-300">C3 4D 8A 11</span></td>
              <td class="py-2.5 px-3 text-slate-400">ESP32_MIT_IOT_LAB_01</td>
              <td class="py-2.5 px-3"><span class="px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 text-[10px] font-bold">✓ Lab-Verified (+50 XP)</span></td>
            </tr>
            <tr class="hover:bg-[#041026]/80 text-slate-200">
              <td class="py-2.5 px-3 text-slate-400">2026-11-04 15:15:02</td>
              <td class="py-2.5 px-3 font-bold text-white">MIT-FAC-019</td>
              <td class="py-2.5 px-3 text-amber-300 font-semibold">Dr. K. S. Parthasarathy</td>
              <td class="py-2.5 px-3"><span class="px-1.5 py-0.5 rounded bg-[#020813] border border-slate-700 text-slate-300">A4 12 99 F0</span></td>
              <td class="py-2.5 px-3 text-slate-400">ESP32_MIT_IOT_LAB_01</td>
              <td class="py-2.5 px-3"><span class="px-2 py-0.5 rounded-full bg-blue-500/20 text-blue-400 border border-blue-500/30 text-[10px] font-bold">✓ Faculty Access</span></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Section 3: Anna University & IEEE Capstone Curriculum Modules -->
  <section class="mb-12">
    <div class="flex items-center justify-between mb-4">
      <div class="flex items-center gap-3">
        <div class="w-2.5 h-6 bg-gradient-to-b from-[#00693E] to-[#00F0B5] rounded-full"></div>
        <h2 class="text-xl font-bold text-white tracking-tight font-mono">
          Anna University ECE Tiered Curriculum & IEEE Capstones
        </h2>
      </div>
      <span class="text-xs font-mono text-[#00F0B5] hidden sm:inline">
        R2021 Regulation • Dept of Electronics Engineering
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <!-- Tier 1: IoT Foundations -->
      <div class="glass-card-hover glass-card p-5 rounded-2xl border border-emerald-500/30 space-y-3 font-mono text-xs">
        <div class="flex justify-between items-center">
          <span class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-400 font-bold text-[10px]">TIER 1 FOUNDATION</span>
          <span class="text-slate-400 text-[10px]">4 Credits • Sem 7</span>
        </div>
        <div class="font-bold text-white text-sm">EC8701: IoT Edge Node Foundations & Bare-Metal GPIO</div>
        <p class="text-slate-400 text-[11px] leading-relaxed">
          Direct memory-mapped atomic registers (W1TS/W1TC), SAR ADC calibration, and the PIR pyroelectric glass refraction trap.
        </p>
        <div class="pt-2 border-t border-slate-800 flex justify-between items-center text-[10px]">
          <span class="text-[#00F0B5]">Trap: Glass Refraction</span>
          <span class="px-2 py-0.5 rounded bg-[#020813] text-emerald-400 border border-emerald-500/20 font-bold">+300 XP</span>
        </div>
      </div>

      <!-- Tier 2: Automotive Edge -->
      <div class="glass-card-hover glass-card p-5 rounded-2xl border border-cyan-500/30 space-y-3 font-mono text-xs">
        <div class="flex justify-between items-center">
          <span class="px-2 py-0.5 rounded bg-cyan-500/20 text-cyan-400 font-bold text-[10px]">TIER 2 AUTOMOTIVE</span>
          <span class="text-slate-400 text-[10px]">4 Credits • Sem 7</span>
        </div>
        <div class="font-bold text-white text-sm">EC8704: Automotive Radar & Ultrasonic Edge Sensing</div>
        <p class="text-slate-400 text-[11px] leading-relaxed">
          Time-of-Flight timer capture, CAN 2.0B mailboxes, and the HC-SR04 speed-of-sound thermal gradient & snowstorm bounce trap.
        </p>
        <div class="pt-2 border-t border-slate-800 flex justify-between items-center text-[10px]">
          <span class="text-cyan-400">Trap: Specular Bounce</span>
          <span class="px-2 py-0.5 rounded bg-[#020813] text-cyan-400 border border-cyan-500/20 font-bold">+350 XP</span>
        </div>
      </div>

      <!-- Tier 3: Defense UAV FHSS -->
