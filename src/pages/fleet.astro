---
import MainLayout from '../layouts/MainLayout.astro';
import FleetManager from '../components/FleetManager.jsx';
import LiveTelemetryStream from '../components/LiveTelemetryStream.jsx';
---

<MainLayout
  title="IoT Edge Fleet Manager & LittleFS Spool | VoltCore Apex Academia"
  description="Manage ESP32 edge nodes deployed across MIT Campus with tamper-evident SHA-256 Merkle chain verification and LittleFS offline queue synchronization."
  activeNav="fleet"
>
  <div class="space-y-6">
    <!-- Breadcrumb & Header -->
    <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-slate-800 text-xs font-mono">
      <div class="flex items-center gap-2 text-slate-400">
        <a href="/" class="hover:text-[#00F0B5] transition-colors">VoltCore</a>
        <span>/</span>
        <span class="text-[#00F0B5]">IoT Fleet Manager</span>
        <span>/</span>
        <span class="text-slate-500">LittleFS Merkle Queue & Live SSE</span>
      </div>
      <div class="flex items-center gap-3">
        <span class="px-2.5 py-1 rounded bg-[#00693E]/30 text-[#00F0B5] border border-[#00F0B5]/30">
          ESP32 FreeRTOS Dual-Core Cluster
        </span>
      </div>
    </div>

    <!-- Interactive Fleet Manager React Component -->
    <FleetManager client:load />

    <!-- Live Telemetry Stream React Component -->
    <div class="pt-6">
      <LiveTelemetryStream client:load />
    </div>
  </div>
</MainLayout>

