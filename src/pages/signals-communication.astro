---
import MainLayout from '../layouts/MainLayout.astro';
import SignalsCommunicationHub from '../components/SignalsCommunicationHub.jsx';

/**
 * ========================================================================================
 * VoltCore Apex Academia - Phase E: Signals & Communication Systems Hub
 * Anna University / MIT Campus - Department of Electronics Engineering (Regulation 2023)
 * Platform Lead: Ashok Kumar A (2023MITEC042)
 * Features 251–260:
 *   - Feature 251: Waveform Generator (Sine, Cos, Square, Triangle, Sawtooth, Sinc, Step)
 *   - Feature 252: Signal Operations (Addition, Subtraction, Multiplication, Beat Frequencies)
 *   - Feature 253: Time Shifting, Scaling & Reversal Visualizer (y(t) = x(at - t0))
 *   - Feature 254: Continuous vs Discrete Signals & Discrete Periodicity Checker
 *   - Feature 255: Fourier Transform Pairs & Continuous Magnitude/Phase Spectrum
 *   - Feature 256: Fourier Series Harmonic Synthesizer & Gibbs Phenomenon
 *   - Feature 257: Linear & Circular Discrete Convolution Calculator
 *   - Feature 258: Sampling Theorem & Aliasing Demonstrator (Nyquist Rate & Aliased Frequency)
 *   - Feature 259: Analog Modulation (AM Modulation Index, Efficiency, FM Carson's Rule)
 *   - Feature 260: Digital Modulation Comparison (BPSK, QPSK, 16-QAM, Constellations & BER)
 * ========================================================================================
 */

const pageMetadata = {
  title: "Signals & Communication Systems Hub | VoltCore Apex Academia",
  lead: "VoltCore Apex",
  rollNo: "Core Series",
  department: "Electronics & Embedded Systems",
  campus: "Autonomous Engineering Cluster",
  regulation: "Modular Engineering Series",
  mode: "Waveforms + Fourier + Convolution + Nyquist Sampling + AM/FM & Digital Modulation"
};
---

<MainLayout title={pageMetadata.title} activeNav="signals-communication">
  <div class="space-y-6 font-mono">
    
    <!-- Hero Header Banner -->
    <div class="glass-card-accent rounded-3xl p-6 sm:p-8 border relative overflow-hidden shadow-2xl" style="border-color: var(--theme-border);">
      <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
        
        <div class="flex items-center gap-5">
          <!-- Glass Cybernetic Avatar -->
          <div class="relative w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-gradient-to-tr from-indigo-500 via-cyan-500 to-emerald-500 p-[2.5px] shadow-emerald-glow flex-shrink-0">
            <div class="w-full h-full bg-slate-950 rounded-[14px] flex items-center justify-center font-bold text-2xl text-indigo-400">
              📡
            </div>
            <span class="absolute -bottom-1 -right-1 h-4 w-4 rounded-full bg-indigo-400 ring-4 ring-slate-950 animate-pulse"></span>
          </div>

          <div>
            <div class="flex flex-wrap items-center gap-2">
              <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight font-sans">
                Signals & Communication Systems Hub
              </h1>
              <span class="px-2.5 py-0.5 rounded-full bg-indigo-500/20 text-indigo-300 text-xs font-bold border border-indigo-500/40">
                PHASE E (FEATURES 251–260)
              </span>
            </div>
            <div class="text-xs sm:text-sm text-slate-300 mt-1">
              {pageMetadata.department} • {pageMetadata.campus}
            </div>
            <div class="text-xs text-slate-400 mt-0.5">
              Platform Architect: <span class="text-white font-bold">{pageMetadata.lead} ({pageMetadata.rollNo})</span> • {pageMetadata.mode}
            </div>
          </div>
        </div>

        <!-- Capability Badges -->
        <div class="flex flex-wrap items-center gap-3">
          <div class="px-4 py-2 rounded-xl bg-slate-900/80 border border-indigo-500/30 text-xs">
            <span class="text-slate-400">DSP / Fourier:</span>
            <span class="text-indigo-400 font-bold ml-1.5">Harmonics & CTFT</span>
          </div>
          <div class="px-4 py-2 rounded-xl bg-slate-900/80 border border-emerald-500/30 text-xs">
            <span class="text-slate-400">Sampling:</span>
            <span class="text-emerald-400 font-bold ml-1.5">Nyquist & Aliasing</span>
          </div>
          <div class="px-4 py-2 rounded-xl bg-slate-900/80 border border-amber-500/30 text-xs">
            <span class="text-slate-400">Modulation:</span>
            <span class="text-amber-400 font-bold ml-1.5">AM / FM & 16-QAM</span>
          </div>
        </div>

      </div>
    </div>

    <!-- Interactive Signals & Communication Hub Island -->
    <SignalsCommunicationHub client:load />

  </div>
</MainLayout>
