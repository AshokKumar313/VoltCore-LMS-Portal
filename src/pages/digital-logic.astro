---
import MainLayout from '../layouts/MainLayout.astro';
import DigitalLogicHub from '../components/DigitalLogicHub.jsx';

/**
 * ========================================================================================
 * VoltCore Apex Academia - Phase C: Digital Electronics Engineering
 * Anna University / MIT Campus - Department of Electronics Engineering (Regulation 2023)
 * Platform Lead: Ashok Kumar A (2023MITEC042)
 * Features 231–240:
 *   - Feature 231: Logic Gate Truth Table Explorer (AND, OR, NOT, NAND, NOR, XOR, XNOR)
 *   - Feature 232: Multi-Radix Base Converter (Bin, Oct, Dec, Hex) with division steps
 *   - Feature 233: Two's Complement & Signed Arithmetic (Overflow V = Cin ^ Cout)
 *   - Feature 234: Boolean Algebra Step-by-Step Axiom Simplifier & De Morgan Verifier
 *   - Feature 235: 4-Variable K-Map (Gray Code: 00, 01, 11, 10) Prime Implicant Reducer
 * ========================================================================================
 */

const pageMetadata = {
  title: "Digital Logic Engineering Hub | VoltCore Apex Academia",
  lead: "VoltCore Apex",
  rollNo: "Core Series",
  department: "Electronics & Embedded Systems",
  campus: "Autonomous Engineering Cluster",
  regulation: "Modular Engineering Series",
  mode: "Gates + Radix Converter + Two's Complement + K-Map Reducer"
};
---

<MainLayout title={pageMetadata.title} activeNav="digital-logic">
  <div class="space-y-6 font-mono">
    
    <!-- Hero Header Banner -->
    <div class="glass-card-accent rounded-3xl p-6 sm:p-8 border relative overflow-hidden shadow-2xl" style="border-color: var(--theme-border);">
      <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
        
        <div class="flex items-center gap-5">
          <!-- Glass Cybernetic Avatar -->
          <div class="relative w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-gradient-to-tr from-cyan-500 via-emerald-500 to-indigo-500 p-[2.5px] shadow-emerald-glow flex-shrink-0">
            <div class="w-full h-full bg-slate-950 rounded-[14px] flex items-center justify-center font-bold text-2xl text-cyan-400">
              ⚡
            </div>
            <span class="absolute -bottom-1 -right-1 h-4 w-4 rounded-full bg-cyan-400 ring-4 ring-slate-950 animate-pulse"></span>
          </div>

          <div>
            <div class="flex flex-wrap items-center gap-2">
              <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight font-sans">
                Digital Logic & Electronics Engineering Hub
              </h1>
              <span class="px-2.5 py-0.5 rounded-full bg-cyan-500/20 text-cyan-300 text-xs font-bold border border-cyan-500/40">
                PHASE C (FEATURES 231–240)
              </span>
            </div>
            <div class="text-xs sm:text-sm text-slate-300 mt-1">
              {pageMetadata.department} • {pageMetadata.campus}
            </div>
            <div class="text-xs text-slate-400 mt-0.5">
              Platform Architect: <span class="text-white font-bold">{pageMetadata.lead} ({pageMetadata.rollNo})</span> • {pageMetadata.mode}
            </div>
          </div>
        </div>

        <!-- Capability Badges -->
        <div class="flex flex-wrap items-center gap-3">
          <div class="px-4 py-2 rounded-xl bg-slate-900/80 border border-cyan-500/30 text-xs">
            <span class="text-slate-400">Logic Gates:</span>
            <span class="text-cyan-400 font-bold ml-1.5">74HC Series</span>
          </div>
          <div class="px-4 py-2 rounded-xl bg-slate-900/80 border border-emerald-500/30 text-xs">
            <span class="text-slate-400">K-Map:</span>
            <span class="text-emerald-400 font-bold ml-1.5">4-Var Gray Code</span>
          </div>
          <div class="px-4 py-2 rounded-xl bg-slate-900/80 border border-amber-500/30 text-xs">
            <span class="text-slate-400">Overflow:</span>
            <span class="text-amber-400 font-bold ml-1.5">V = Cin ⊕ Cout</span>
          </div>
        </div>

      </div>
    </div>

    <!-- Interactive Digital Logic Hub React Island -->
    <DigitalLogicHub client:load />

  </div>
</MainLayout>
