---
import MainLayout from '../layouts/MainLayout.astro';
import PersonalizedLearningHub from '../components/PersonalizedLearningHub.jsx';

/**
 * ========================================================================================
 * VoltCore Apex Academia - Phase A: Personalized Learning Dashboard & Adaptive Path
 * Anna University / MIT Campus - Department of Electronics Engineering (Regulation 2023)
 * Platform Lead: Ashok Kumar A (2023MITEC042)
 * Features 201–202:
 *   - Feature 201: Personalized Learning Dashboard (Domain mastery, cognitive gaps, study velocity)
 *   - Feature 202: Adaptive Learning Path Generator (Prerequisite DAG, career goals, diagnostic quiz)
 * ========================================================================================
 */

const pageMetadata = {
  title: "Personalized Learning Hub & Adaptive Path | VoltCore Apex Academia",
  lead: "VoltCore Apex",
  rollNo: "Core Series",
  department: "Electronics & Embedded Systems",
  campus: "Autonomous Engineering Cluster",
  regulation: "Modular Engineering Series",
  mode: "Domain Mastery + Cognitive Gap Detection + Adaptive Career DAG"
};
---

<MainLayout title={pageMetadata.title} activeNav="learning-dashboard">
  <div class="space-y-6 font-mono">
    
    <!-- Hero Header Banner -->
    <div class="glass-card-accent rounded-3xl p-6 sm:p-8 border relative overflow-hidden shadow-2xl" style="border-color: var(--theme-border);">
      <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
        
        <div class="flex items-center gap-5">
          <!-- Glass Cybernetic Avatar -->
          <div class="relative w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-gradient-to-tr from-emerald-500 via-teal-500 to-cyan-500 p-[2.5px] shadow-emerald-glow flex-shrink-0">
            <div class="w-full h-full bg-slate-950 rounded-[14px] flex items-center justify-center font-bold text-2xl text-emerald-400">
              📊
            </div>
            <span class="absolute -bottom-1 -right-1 h-4 w-4 rounded-full bg-emerald-400 ring-4 ring-slate-950 animate-pulse"></span>
          </div>

          <div>
            <div class="flex flex-wrap items-center gap-2">
              <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight font-sans">
                Personalized Learning Hub & Adaptive Path
              </h1>
              <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 text-xs font-bold border border-emerald-500/40">
                PHASE A (FEATURES 201–202)
              </span>
            </div>
            <div class="text-xs sm:text-sm text-slate-300 mt-1">
              {pageMetadata.department} • {pageMetadata.campus}
            </div>
            <div class="text-xs text-slate-400 mt-0.5">
              Platform Architect: <span class="text-white font-bold">{pageMetadata.lead} ({pageMetadata.rollNo})</span> • {pageMetadata.mode}
            </div>
          </div>
        </div>

        <!-- Capability Badges -->
        <div class="flex flex-wrap items-center gap-3">
          <div class="px-4 py-2 rounded-xl bg-slate-900/80 border border-emerald-500/30 text-xs">
            <span class="text-slate-400">Mastery:</span>
            <span class="text-emerald-400 font-bold ml-1.5">5 ECE Domains</span>
          </div>
          <div class="px-4 py-2 rounded-xl bg-slate-900/80 border border-cyan-500/30 text-xs">
            <span class="text-slate-400">Adaptive DAG:</span>
            <span class="text-cyan-400 font-bold ml-1.5">3 Career Tracks</span>
          </div>
          <div class="px-4 py-2 rounded-xl bg-slate-900/80 border border-amber-500/30 text-xs">
            <span class="text-slate-400">Cognitive Gaps:</span>
            <span class="text-amber-400 font-bold ml-1.5">Real-Time Alert</span>
          </div>
        </div>

      </div>
    </div>

    <!-- Interactive Personalized Learning Hub Island -->
    <PersonalizedLearningHub client:load />

  </div>
</MainLayout>
